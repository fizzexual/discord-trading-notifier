# Required: your Discord bot token (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Optional: Twelve Data API key for real-time gold/silver prices (free at twelvedata.com).
# Leave blank to use Yahoo Finance (free, no key, ~15 minute delay).
TWELVE_DATA_KEY=

# How often the alert loop polls prices, in seconds. Default 300 (5 minutes).
CHECK_INTERVAL_SECONDS=300
